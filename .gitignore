# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# ログ・一時ファイル・SQLite の DB (ディレクトリは Rails と Prisma が作る)
/log/
/tmp/
/storage/

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Node のパッケージ (Prisma / hekireki)
/node_modules

# Prisma のマイグレーションは残さない。スキーマは `prisma db push` で DB に反映する
/prisma/migrations/

# プロジェクト内に入れた gem (bundle config set --local path vendor/bundle)
/vendor/bundle

# Tailwind CSS のビルド結果。サーバー起動時にディレクトリが必要なので .keep だけ残す
/app/assets/builds/*
!/app/assets/builds/.keep

# YARD が生成するドキュメントとキャッシュ (bundle exec yard doc)
/doc/
/.yardoc/